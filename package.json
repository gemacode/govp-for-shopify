{
  "name": "govp-for-shopify",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check:shopify-config": "node scripts/check-shopify-config.mjs",
    "validate:shopify": "shopify app config validate --path . --client-id 00000000000000000000000000000000 --no-color",
    "check": "npm run check:shopify-config && npm run typecheck && npm test && npm run build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "hono": "4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@shopify/cli": "4.6.1",
    "@types/node": "26.2.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
